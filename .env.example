# 이 파일을 .env 로 복사하고 키를 넣으세요. (화면에서 입력해도 .env가 자동 생성됩니다)
OPENAI_API_KEY=sk-...

# 선택 설정
PORT=3000
REALTIME_MODEL=gpt-realtime-translate
TRANSCRIBE_MODEL=gpt-realtime-whisper
# 원문 받아쓰기 전용 세션 모델 (번역 세션의 원문이 빠지는 문제 보완, off 이면 사용 안 함)
STT_MODEL=gpt-live-transcribe
# 자막 보정·답변 번역·자료 요약용 텍스트 모델 (빠르고 저렴한 모델 권장)
TEXT_MODEL=gpt-4.1-mini
# 회의록 작성자 기본값과 회의록 프롬프트에 쓰는 회사명 (선택)
COMPANY_NAME=
# 회의록 작성 모델 (선택)
MINUTES_MODEL=gpt-4.1
